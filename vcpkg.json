{
  "name": "xstarbound",
  "version": "1.0.0",
  "default-features": [
    "gui",
    "opengl"
  ],
  "dependencies": [
    "freetype",
    "zlib",
    "libpng",
    "libogg",
    "libvorbis",
    "opus"
  ],
  "features": {
    "opengl": {
      "description": "Build the OpenGL renderer",
      "dependencies": ["glew"]
    },
    "vulkan": {
      "description": "Enable SDL Vulkan presentation for the experimental backend",
      "dependencies": [
        { "name": "sdl2", "default-features": false, "features": ["vulkan"] }
      ]
    },
    "gui": {
      "description": "Build client GUI",
      "dependencies": [
        { "name": "sdl2", "default-features": false, "features": ["wayland", "x11", "alsa"], "platform": "linux" },
        { "name": "sdl2", "default-features": false, "platform": "!linux" }
      ]
    },
    "qttools": {
      "description": "Build Qt-based tools",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "widgets",
            {
              "name": "xcb",
              "platform": "linux"
            },
            {
              "name": "fontconfig",
              "platform": "linux"
            }
          ]
        },
        "qtsvg"
      ]
    },
    "jemalloc": {
      "description": "Use jemalloc memory allocator",
      "dependencies": [
        "jemalloc"
      ]
    },
    "mimalloc": {
      "description": "Use mimalloc memory allocator",
      "dependencies": [
        "mimalloc"
      ]
    },
    "tests": {
      "description": "Build unit tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
